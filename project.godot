; Six-map campaign, original audio and adaptive full-window canvas.
config_version=5

[application]
config/name="暮境守卫 · 开发版"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/守望边境 · 开发版"
config/version="0.4.1-dev"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="六关战役开发版；包含音乐、战斗音效及全屏适配。"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.17, 0.14, 1)
